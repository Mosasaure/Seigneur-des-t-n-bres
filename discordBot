# kick une personne

@bot.command()
@commands.has_permissions(kick_members = True)
async def kick(ctx, user : d.Member, *, reason = "Aucune raison n'a été spécifiée"):
    reason = "".join(reason)

    em = d.Embed(
    title = "Expulsion",
    description = f"{user.mention} a été **expulsé** par {ctx.author} !\nRaison : *{reason}*",
    color = 0xFF0000
    )
    em.set_thumbnail(url = user.avatar)

    await ctx.guild.kick(user, reason = reason)
    
    await ctx.send(embed = em)

    # await ctx.send(f"{user.mention} a été **expulsé** par {ctx.author} !\nRaison : {reason}")

@bot.command()
async def clear(ctx, nb : int):
    messages = ctx.channel.history(limit = nb + 1)
    for message in messages:
        await message.delete()

